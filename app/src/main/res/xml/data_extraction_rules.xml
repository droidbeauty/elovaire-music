<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="portable_settings.xml" />
        <include
            domain="file"
            path="portable_user_data_v1.json" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="portable_settings.xml" />
        <include
            domain="file"
            path="portable_user_data_v1.json" />
    </device-transfer>
</data-extraction-rules>
